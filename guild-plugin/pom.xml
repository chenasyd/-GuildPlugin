<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guild</groupId>
        <artifactId>guild-parent</artifactId>
        <version>1.6.7</version>
    </parent>

    <artifactId>guild-plugin</artifactId>
    <packaging>jar</packaging>

    <name>Guild Plugin</name>
    <description>一个功能完整的我的世界公会插件</description>

    <dependencies>
        <!-- Guild SDK -->
        <dependency>
            <groupId>com.guild</groupId>
            <artifactId>guild-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Guild Communication Bridge -->
        <dependency>
            <groupId>com.guild</groupId>
            <artifactId>guild-comm</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spigot API -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
        </dependency>

        <!-- PlaceholderAPI -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
        </dependency>

        <!-- Vault API -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
        </dependency>

        <!-- ImagoCore (soft dependency — GUI image integration) -->
        <dependency>
            <groupId>org.a</groupId>
            <artifactId>imagocore</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Item NBT API (softdepend — guild warehouse item serialization) -->
        <dependency>
            <groupId>de.tr7zw</groupId>
            <artifactId>item-nbt-api-plugin</artifactId>
            <version>2.15.7</version>
            <scope>provided</scope>
        </dependency>

        <!-- WorldEdit / WorldGuard (softdepend — guild territory module) -->
        <dependency>
            <groupId>com.sk89q.worldedit</groupId>
            <artifactId>worldedit-bukkit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
        </dependency>

        <!-- Cumulus Form Library — shaded+relocated into plugin JAR.
             In single-server mode with Geyser, forms are serialized to JSON and
             re-deserialized via Geyser's ClassLoader (avoids ClassLoader mismatch).
             In BungeeCord mode without local Geyser, forms are serialized and
             forwarded to the proxy which sends them via its Geyser instance. -->
        <dependency>
            <groupId>org.geysermc.cumulus</groupId>
            <artifactId>cumulus</artifactId>
            <version>1.1.2</version>
            <scope>compile</scope>
        </dependency>

        <!-- Adventure API (for ImagoCore hook compilation) -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.17.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- MySQL Connector/J -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- HikariCP for connection pooling -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!-- JSON处理 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- 配置管理 -->
        <dependency>
            <groupId>org.spongepowered</groupId>
            <artifactId>configurate-yaml</artifactId>
        </dependency>

        <!-- 日志框架 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

            <!-- bStats Metrics -->
            <dependency>
                <groupId>org.bstats</groupId>
                <artifactId>bstats-bukkit</artifactId>
            </dependency>

            <!-- JUnit 5 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.10.2</version>
                <scope>test</scope>
            </dependency>

            <!-- H2 in-memory DB for repository tests -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>2.2.224</version>
                <scope>test</scope>
            </dependency>

            <!-- SQLite JDBC for schema initializer tests -->
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>3.45.3.0</version>
                <scope>test</scope>
            </dependency>

            <!-- Mockito for mocking DatabaseManager in tests -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>5.11.0</version>
                <scope>test</scope>
            </dependency>

            <!-- MockBukkit for command/GUI integration tests (test scope only; Paper API 禁止进入主工程) -->
            <dependency>
                <groupId>com.github.seeseemelk</groupId>
                <artifactId>MockBukkit-v1.20</artifactId>
                <version>3.32.1</version>
                <scope>test</scope>
            </dependency>
        </dependencies>

    <!-- Project-local repository for third-party JARs (e.g. ImagoCore) -->
    <repositories>
        <repository>
            <id>project-local-repo</id>
            <url>file://${project.basedir}/libs</url>
        </repository>
    </repositories>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- 示例 Demo 模块不计入基线；territory 纳入 CI 监控 -->
                    <excludes>
                        <exclude>com/guild/module/example/announcement/**</exclude>
                        <exclude>com/guild/module/example/apitest/**</exclude>
                        <exclude>com/guild/module/example/member/**</exclude>
                        <exclude>com/guild/module/example/quest/**</exclude>
                        <exclude>com/guild/module/example/stats/**</exclude>
                        <exclude>com/guild/module/example/testlang/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-spigot-api-only</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>io.papermc:*:*:*:test</exclude>
                                    </excludes>
                                    <includes>
                                        <include>io.papermc:*</include>
                                    </includes>
                                    <message>guild-plugin 运行时仅允许 spigot-api；Paper 依赖不得出现在 compile/runtime/provided scope。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                    <excludes>
                                        <exclude>com/guild/module/example/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- guild-sdk 中的 com/guild/comm/** 是编译期空壳 stub，
                                     运行时必须使用 guild-comm 的真实实现，否则所有通信功能失效 -->
                                <filter>
                                    <artifact>com.guild:guild-sdk</artifact>
                                    <excludes>
                                        <exclude>com/guild/comm/**</exclude>
                                        <!-- 运行时使用 guild-plugin 完整实现，避免 SDK 编译期 stub 覆盖 -->
                                        <exclude>com/guild/core/module/ModuleContext.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>com.guild.libs.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>com.guild.libs.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>com.guild.libs.bstats</shadedPattern>
                                </relocation>
                                <!-- Cumulus 表单库重定位：避免与 Geyser 内置 Cumulus 的 ClassLoader 冲突。
                                     本插件使用 com.guild.libs.cumulus，Geyser 使用 org.geysermc.cumulus，
                                     通过 JSON 序列化/反序列化在两者之间桥接。 -->
                                <relocation>
                                    <pattern>org.geysermc.cumulus</pattern>
                                    <shadedPattern>com.guild.libs.cumulus</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>build-announcement-module</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/announcement-module.xml</descriptor>
                            </descriptors>
                            <finalName>announcement</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <attach>false</attach>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-announcement-module</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>build-member-rank-module</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/member-rank-module.xml</descriptor>
                            </descriptors>
                            <finalName>member-rank</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <attach>false</attach>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-member-rank-module</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>build-guild-stats-module</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/guild-stats-module.xml</descriptor>
                            </descriptors>
                            <finalName>guild-stats</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <attach>false</attach>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-guild-stats-module</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>build-quest-module</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/quest-module.xml</descriptor>
                            </descriptors>
                            <finalName>guild-quest</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <attach>false</attach>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-quest-module</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>build-api-test-module</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/api-test-module.xml</descriptor>
                            </descriptors>
                            <finalName>api-test</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <attach>false</attach>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-api-test-module</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>build-testlang-module</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/testlang-module.xml</descriptor>
                            </descriptors>
                            <finalName>testlang</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <attach>false</attach>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-testlang-module</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- 阶段 0：profile 预置但不默认启用；CI 仍用 mvn verify（无 -P）。阶段 1 起 CI 加 -Pcoverage-gate -->
        <profile>
            <id>coverage-gate</id>
            <properties>
                <jacoco.schema.line.minimum>0.95</jacoco.schema.line.minimum>
                <jacoco.war.model.line.minimum>0.85</jacoco.war.model.line.minimum>
                <jacoco.world.registry.line.minimum>0.84</jacoco.world.registry.line.minimum>
                <jacoco.permissions.line.minimum>0.70</jacoco.permissions.line.minimum>
                <jacoco.repository.line.minimum>0.40</jacoco.repository.line.minimum>
                <jacoco.gui.base.line.minimum>0.35</jacoco.gui.base.line.minimum>
                <jacoco.gui.session.line.minimum>0.50</jacoco.gui.session.line.minimum>
                <jacoco.territory.line.minimum>0.15</jacoco.territory.line.minimum>
                <jacoco.activity.line.minimum>0.20</jacoco.activity.line.minimum>
                <jacoco.warehouse.line.minimum>0.15</jacoco.warehouse.line.minimum>
                <jacoco.war.line.minimum>0.25</jacoco.war.line.minimum>
                <jacoco.update.security.line.minimum>0.80</jacoco.update.security.line.minimum>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.core.database.schema</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.schema.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.war.model</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.war.model.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.world.registry</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.world.registry.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.core.permissions</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.permissions.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.services.repository</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.repository.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.gui.base</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.gui.base.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.core.gui.session</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.gui.session.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.module.example.territory</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.territory.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.activity</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.activity.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>PACKAGE</element>
                                            <includes>
                                                <include>com.guild.warehouse</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.warehouse.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>CLASS</element>
                                            <includes>
                                                <include>com.guild.update.UpdateDownloadSecurity</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.update.security.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                            <execution>
                                <id>check-war-module</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>com/guild/war/**</include>
                                    </includes>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.war.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>build-territory-module</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/territory-module.xml</descriptor>
                            </descriptors>
                            <finalName>guild-territory</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <attach>false</attach>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-territory-module</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
